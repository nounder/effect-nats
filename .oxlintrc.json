{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "import"
  ],
  "rules": {
    "eslint/no-console": "warn",
    "import/no-default-export": "error"
  },
  "ignorePatterns": [
    "dist",
    "node_modules"
  ],
  "overrides": [
    {
      "files": [
        "bench/**"
      ],
      "rules": {
        "eslint/no-console": "off"
      }
    }
  ]
}
